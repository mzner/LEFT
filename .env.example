# Copy to .env and fill in. See README.md for how to register the OAuth apps.

# Random string used to sign the session cookie: `openssl rand -hex 32`
SESSION_SECRET=

# Atlassian OAuth 2.0 (3LO) app — https://developer.atlassian.com/console/myapps/
# Callback URL: http://localhost:5173/auth/atlassian/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Your Jira site, e.g. https://your-site.atlassian.net
ATLASSIAN_SITE_URL=

# GitHub OAuth App — https://github.com/settings/developers
# Callback URL: http://localhost:5173/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Optional ---------------------------------------------------------------

# Show sample data instead of Jira/GitHub; no OAuth apps or secrets needed.
# DEMO_MODE=true

# URL the browser uses to reach the dashboard, and the server's own port.
# PUBLIC_URL=http://localhost:5173
# SERVER_PORT=3000

# Jira project.
# JIRA_PROJECT_KEY=OCISDEV

# Scopes requested at sign-in; must match the app's scopes in the developer console.
# The default only reads. Add write:jira-work (here and in the console) to get a
# "Link in Jira" button that adds a PR to its ticket as a web link.
# ATLASSIAN_SCOPES="read:jira-work read:jira-user read:board-scope:jira-software read:sprint:jira-software read:project:jira read:issue-details:jira read:jql:jira offline_access"

# An open backport older than this many days gets the "Backport stale" problem.
# 0 turns it off.
# STALE_BACKPORT_DAYS=7

# Repos whose stable branches are not named stable-X.Y. Comma-separated repo=template.
# BRANCH_TEMPLATES="owncloud/web=release-{major}.{minor}"

# Address the server listens on (the Docker image sets 0.0.0.0) and the log level.
# HOST=127.0.0.1
# LOG_LEVEL=info
